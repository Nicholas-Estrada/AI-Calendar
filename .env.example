# Used by the Vite web client. Firebase web configuration is public project metadata;
# never place the Gemini API key in a VITE_ variable.
VITE_FIREBASE_API_KEY=replace-with-your-firebase-web-api-key

# Leave unset locally, where Vite proxies /api to FastAPI.
# VITE_API_BASE_URL=https://api.example.com/api
