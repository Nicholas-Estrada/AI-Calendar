rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isCalendarDate(value) {
      return value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidEvent() {
      return request.resource.data.keys().hasAll([
          'assignmentId', 'kind', 'source', 'start', 'status', 'title',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'assignmentId', 'description', 'kind', 'source', 'start', 'status',
          'title', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.assignmentId is string
        && request.resource.data.assignmentId.size() > 0
        && request.resource.data.kind in ['deadline', 'milestone']
        && request.resource.data.source in ['ai', 'manual']
        && isCalendarDate(request.resource.data.start)
        && request.resource.data.status in ['PENDING', 'COMPLETED']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidAssignment() {
      return request.resource.data.keys().hasAll([
          'title', 'finalDueDate', 'source', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'title', 'finalDueDate', 'rawPrompt', 'source', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && isCalendarDate(request.resource.data.finalDueDate)
        && request.resource.data.source in ['ai', 'manual']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow read, create, update, delete: if isOwner(uid);

      match /assignments/{assignmentId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidAssignment();
      }

      match /events/{eventId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidEvent();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
